{
  "expo": {
    "name": "Fresh By Brham",
    "slug": "freshbybrham",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fav-icon.png",
    "scheme": "freshbybrham",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.freshbybrham.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.freshbybrham.app",
      "versionCode": 1,
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#F3F0E9",
        "foregroundImage": "./assets/images/fav-icon.png",
        "backgroundImage": "./assets/images/android-icon-background-brand.png",
        "monochromeImage": "./assets/images/android-icon-monochrome-brand.png"

      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/fav-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-brand.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F0E9",
          "dark": {
            "backgroundColor": "#F3F0E9"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74ebe18d-0932-4289-a419-f33365346aef"
      }
    }
  }
}
